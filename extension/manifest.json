{
  "manifest_version": 3,
  "name": "IDM Clone Integration",
  "version": "1.0.0",
  "description": "Sends downloads, links and detected videos to the IDM Clone desktop app.",
  "permissions": [
    "downloads",
    "contextMenus",
    "webRequest",
    "storage",
    "cookies",
    "tabs",
    "scripting",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "IDM Clone",
    "default_icon": "icon128.png"
  },
  "icons": {
    "128": "icon128.png"
  }
}